ml-service/models/*.pkl
ml-service/models/*.npy

# Generated dataset (recreated by data/generate_dataset.py)
ml-service/data/*.csv

# Load-test dumps and nginx runtime logs
load-test/results/*.txt
load-test/results/*.json
load-test/results/*_dump*
load-test/results/*measured*
load-test/nginx/logs/
*.har

# OS and editor
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*~
.python-version
.colima/

# Test / coverage
backend/**/target/surefire-reports/
frontend/coverage/
.pytest_cache/

# Maven wrapper jar (downloaded, not committed)
backend/.mvn/wrapper/maven-wrapper.jar
