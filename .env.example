# Copy to .env and adjust. Docker Compose and application.yml read these.
# Never commit a real .env file.

# Postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=50

# JWT (generate something unique before any non-local use)
#   openssl rand -base64 48
JWT_SECRET=dev-only-local-secret-do-not-use-in-production-replace-via-env-var

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Anomaly scoring gRPC
ANOMALY_SCORING_GRPC_TARGET=localhost:50051
ANOMALY_SCORING_DEADLINE_MS=800

# Optional mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@expensemanagement.com

# OCR (local Tesseract data path; Docker image sets this itself)
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
